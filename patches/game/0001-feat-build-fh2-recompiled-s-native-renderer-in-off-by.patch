index 7937a33..d0af37b 100644
--- a/forza-recomp/src/forza_app.h
+++ b/forza-recomp/src/forza_app.h
@@ -20,6 +20,8 @@
 #include "platform/vulkan_hooks.h"
 #include "platform/xr.h"
 #include "platform/ultrawide.h"
+#include "nativo/nfsmw_ajustes_graficos.h"
+#include "nativo/nfsmw_nativo_sistema.h"
 #include <rex/ui/window.h>
 #include <rex/cvar.h>
 #include <array>
@@ -84,6 +86,13 @@ class ForzaApp : public rex::ReXApp {
     // VR (vr_mode): the OpenXR runtime must create the Vulkan instance and device, so it is set
     // up before the GPU plugin makes its provider (src/platform/xr.h).
     forza::xr::Prepare();
+    // The native renderer (FH2 Recompiled's, src/nativo): with nfsmw_renderizador = nativo the graphics system is
+    // its own, drawing the game's command ring with Vulkan, and the GPU plugin is not loaded. Off by default.
+    if (!config.graphics && nfsmw::nativo::Activo()) {
+      config.graphics = nfsmw::nativo::CrearSistemaGrafico();
+      // FXAA (nfsmw_antialiasing) and the optional post-processing reach its output pass through these.
+      nfsmw::ajustes::VigilarAjustesEnVivo();
+    }
     if (!config.graphics && config.gpu_plugin.empty()) {
       config.gpu_plugin = "xenos";
     }
diff --git a/forza-recomp/src/nativo/fh1_nativo_enlaces.cpp b/forza-recomp/src/nativo/fh1_nativo_enlaces.cpp
new file mode 100644
