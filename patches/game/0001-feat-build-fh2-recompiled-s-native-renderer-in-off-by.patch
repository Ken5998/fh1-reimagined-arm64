 .../src/nativo/nfsmw_ajustes_graficos.cpp     |   2 +
 .../src/nativo/nfsmw_nativo_destinos.cpp      |  46 ++++++-
 .../src/nativo/nfsmw_nativo_shaders.cpp       |  83 ++++++++++++
 .../src/nativo/nfsmw_nativo_shaders.h         |   5 +
 .../src/nativo/nfsmw_nativo_sistema.cpp       |  12 +-
 tools/cmake/linux-host-check/CMakeLists.txt   |   6 +
 10 files changed, 368 insertions(+), 5 deletions(-)
 create mode 100644 forza-recomp/src/nativo/fh1_nativo_enlaces.cpp
 create mode 100644 forza-recomp/src/nativo/fh1_nativo_ganchos.cpp

diff --git a/forza-recomp/CMakeLists.txt b/forza-recomp/CMakeLists.txt
index 3b48bb2..c31ac7f 100644
--- a/forza-recomp/CMakeLists.txt
+++ b/forza-recomp/CMakeLists.txt
@@ -249,6 +249,31 @@ set(FORZA_SOURCES
     src/platform/xr.cpp
 )
 
+# The native renderer of FH2 Recompiled (github.com/gabrick75/fh2-recompiled app/src/nativo, GPL-3.0, from
+# NFSMW Android Evolved's): with nfsmw_renderizador = nativo it reads the command ring and draws with Vulkan
+# instead of emulating the Xenos GPU, from a shader library made from the player's game (fh1_shaders.nfsp beside
+# the executable). FH2's engine is FH1's, so it is built with FH2's branches (FH2_RECOMP) and FH1's few own
+# answers (FH1_RECOMP, src/nativo/fh1_*.cpp). Copied in by fh1-reimagined-arm64's scripts/prepare.sh.
+set(FORZA_NATIVE_RENDERER_SOURCES
+    src/nativo/nfsmw_nativo_sistema.cpp
+    src/nativo/nfsmw_nativo_destinos.cpp
+    src/nativo/nfsmw_nativo_dibujos.cpp
+    src/nativo/nfsmw_nativo_shaders.cpp
+    src/nativo/nfsmw_nativo_ganchos.cpp
+    src/nativo/nfsmw_nativo_texturas_pool.cpp
+    src/nativo/nfsmw_nativo_captura.cpp
+    src/nativo/nfsmw_shader_library.cpp
+    src/nativo/nfsmw_espera_anillo.cpp
+    src/nativo/nfsmw_ajustes_graficos.cpp
+    src/nativo/fh1_nativo_ganchos.cpp
+    src/nativo/fh1_nativo_enlaces.cpp
+)
+list(APPEND FORZA_SOURCES ${FORZA_NATIVE_RENDERER_SOURCES})
+# Its Vulkan headers see the WSI stubs, as src/platform/vulkan_hooks.cpp does.
+set_source_files_properties(${FORZA_NATIVE_RENDERER_SOURCES} PROPERTIES
+    COMPILE_DEFINITIONS "FH2_RECOMP=1;FH1_RECOMP=1"
+    INCLUDE_DIRECTORIES "${CMAKE_CURRENT_SOURCE_DIR}/src/nativo;${CMAKE_CURRENT_SOURCE_DIR}/src/platform/wsi_stubs")
+
 # The D3D trace (docs/native-renderer.md "Tools"): counting wrappers around the TU4 D3D library's
 # functions that tag the command-buffer dwords each one writes, for the GPU plugin's PM4 trace
 # (ReIGlue built with REXGLUE_FH1_PM4_TRACE). A study build only: it costs every D3D call.
