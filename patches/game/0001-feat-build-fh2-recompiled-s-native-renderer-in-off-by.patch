diff --git a/forza-recomp/src/nativo/nfsmw_nativo_shaders.cpp b/forza-recomp/src/nativo/nfsmw_nativo_shaders.cpp
index c7a1f02..0108aec 100644
--- a/forza-recomp/src/nativo/nfsmw_nativo_shaders.cpp
+++ b/forza-recomp/src/nativo/nfsmw_nativo_shaders.cpp
@@ -53,6 +53,76 @@ constexpr uint32_t kFetchConserva[3] = {0x0007FFFF, 0x80000FFF, 0x80000000};
 
 constexpr uint32_t kMaxAvisos = 48;
 
+#if defined(FH1_RECOMP)
+/*
+ * Forza Horizon 1: what its D3D changes in a vertex shader when it binds it (ReImagined's
+ * tools/fxobj_shaders.py, derive_binding, checked against every shader the game loaded on a PC): the
+ * vertex fetches' layout fields, each ALU export's destination (relinked to the pixel shader's inputs), and
+ * the exports the pixel shader does not read, made into an ALU instruction with no writes. The library's
+ * translation links the stages by semantic, so a shader that differs from its container only there is that
+ * container. Used when the patcher hook has not reported the copy (fh1_nativo_ganchos.cpp).
+ */
+constexpr uint32_t kFh1FetchLayout[3] = {0x3FF00000u, 0x7F3F7FFFu, 0x7FFFFFFFu};
+constexpr uint32_t kFh1Exportacion = 0x01003F3Fu;
+constexpr uint32_t kFh1AluNop[3] = {0xC8000000u, 0x00000000u, 0x02000000u};
+
+// The instruction indices of the vertex fetches, from the exec control flow instructions (fxobj_shaders.py
+// vertex_fetch_slots).
+std::vector<bool> Fh1RanurasFetch(std::span<const uint32_t> w) {
+  std::vector<bool> ranuras(w.size() / 3 + 1, false);
+  size_t fin_cf = SIZE_MAX;
+  for (size_t i = 0; 3 * i + 2 < w.size() && i < fin_cf; ++i) {
+    const uint64_t a = w[3 * i], b = w[3 * i + 1], c = w[3 * i + 2];
+    const uint64_t instrucciones[2] = {a | ((b & 0xFFFFu) << 32), (b >> 16) | (c << 16)};
+    for (const uint64_t ins : instrucciones) {
+      const uint32_t op = uint32_t(ins >> 44) & 0xF;
+      if (op == 1 || op == 2 || op == 3 || op == 4 || op == 5 || op == 6 || op == 13 || op == 14) {
+        const size_t direccion = size_t(ins & 0xFFF), cuenta = size_t(ins >> 12) & 7;
+        const uint32_t secuencia = uint32_t(ins >> 16) & 0xFFF;
+        fin_cf = std::min(fin_cf, direccion);
+        for (size_t k = 0; k < cuenta; ++k) {
+          const size_t indice = direccion + k;
+          if (((secuencia >> (2 * k)) & 1) && 3 * indice < w.size() && (w[3 * indice] & 0x1F) == 0 &&
+              indice < ranuras.size()) {
+            ranuras[indice] = true;
+          }
+        }
+        if (op == 2 || op == 4 || op == 6 || op == 14) {
+          return ranuras;
+        }
+      }
+    }
+  }
+  return ranuras;
+}
+
+// Whether `cargado` (as the ring loaded it) is the container `original` (its unmasked microcode) bound by D3D.
+bool Fh1MismoVsEnlazado(std::span<const uint32_t> original, std::span<const uint32_t> cargado) {
+  if (original.size() != cargado.size() || original.size() % 3) {
+    return false;
+  }
+  const std::vector<bool> ranuras = Fh1RanurasFetch(original);
+  for (size_t i = 0; i < original.size(); ++i) {
+    const uint32_t x = original[i], y = cargado[i];
+    if (x == y) {
+      continue;
+    }
+    const size_t k = i / 3, j = i % 3;
+    if (ranuras[k]) {
+      if ((x ^ y) & ~kFh1FetchLayout[j]) {
+        return false;
+      }
+    } else if (cargado[3 * k] == kFh1AluNop[0] && cargado[3 * k + 1] == kFh1AluNop[1] &&
+               cargado[3 * k + 2] == kFh1AluNop[2]) {
+      // An export the pixel shader does not read, nulled out.
+    } else if (!(j == 0 && ((x >> 15) & 1) && !((x ^ y) & ~kFh1Exportacion))) {
+      return false;
+    }
+  }
+  return true;
+}
