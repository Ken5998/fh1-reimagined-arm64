+}  // namespace nfsmw::nativo
diff --git a/forza-recomp/src/nativo/fh1_nativo_ganchos.cpp b/forza-recomp/src/nativo/fh1_nativo_ganchos.cpp
new file mode 100644
index 0000000..0bcec90
--- /dev/null
+++ b/forza-recomp/src/nativo/fh1_nativo_ganchos.cpp
@@ -0,0 +1,127 @@
+// Forza Horizon 1 (Title Update 4)'s hooks for the native renderer (FH2 Recompiled's, src/nativo, built with
+// FH2_RECOMP and FH1_RECOMP).
+//
+// FH1 and FH2 on the Xbox 360 share the engine and the XDK's Direct3D library, and in TU4 that library is FH2's
+// code at shifted addresses:
+//   - its low part by 0xC5678: the swap is sub_82AACAA0 here and sub_82B72118 in FH2, RunCommandBuffer of
+//     type 10 sub_82AA9898 and sub_82B6EF10. The shader constructors sit between them in FH2 (CreatePixelShader
+//     sub_82B70280, CreateVertexShader sub_82B70468), so here they are sub_82AAAC08 and sub_82AAADF0;
+//   - around the draws by 0x201B0 (DrawVertices sub_82445F18 / sub_82425D68, DrawIndexedVertices sub_82446330 /
+//     sub_82426180, RunCommandBuffer sub_824469B0 / sub_82426800) and by 0x20198 a little lower (the DRAW_INDX
+//     writer sub_82438B20 / sub_82418988). FH2's vertex fetch patcher (sub_8241ACA0) lies between those, so
+//     here it starts between 0x8243AE38 and 0x8243AE50.
+//
+// The originals are weak references: a hook whose function the codegen did not make is never called and links
+// anyway. Every patcher candidate is hooked; only a call whose object is a vertex shader the constructor hook
+// saw counts, so a neighbour that happens to start in that range reports nothing. The log's "[fh1 nativo]" line
+// says which candidates ran (Fh1ResumenGanchos).
+
+#include <atomic>
+#include <cstdint>
+#include <string>
+
+#include <fmt/format.h>
+
+#include <rex/hook.h>
+#include <rex/logging.h>
+#include <rex/ppc/func.h>
+
+#include "nfsmw_nativo_ganchos.h"
+
+namespace nativo = nfsmw::nativo;
+
+#if defined(FORZA_TITLE_UPDATE) && FORZA_TITLE_UPDATE == 4
+
+namespace {
+
+std::atomic<uint64_t> g_creados_ps{0}, g_creados_vs{0};
+
+// A heap or physical address a constructor could have been handed a shader container at.
+bool DireccionPlausible(uint32_t direccion) {
+  return direccion >= 0x40000000u && (direccion & 3) == 0 && direccion < 0xFFFF0000u;
+}
+
+constexpr uint32_t kCandidatosParcheador[] = {0x8243AE38, 0x8243AE3C, 0x8243AE40, 0x8243AE44,
+                                              0x8243AE48, 0x8243AE4C, 0x8243AE50};
+constexpr size_t kNumCandidatos = sizeof(kCandidatosParcheador) / sizeof(kCandidatosParcheador[0]);
+std::atomic<uint64_t> g_llamadas[kNumCandidatos]{};
+std::atomic<uint64_t> g_parches[kNumCandidatos]{};
+
+void Parcheador(size_t candidato, uint32_t objeto, uint32_t destino, uint32_t variante) {
+  g_llamadas[candidato].fetch_add(1, std::memory_order_relaxed);
+  if (!objeto || !nativo::ShaderDeObjeto(objeto)) {
+    return;
+  }
+  if (g_parches[candidato].fetch_add(1, std::memory_order_relaxed) < 4) {
+    REXLOG_INFO("[fh1 nativo] parcheador de fetch sub_{:08X}: VS {:08X} -> {:08X} (variante {})",
+                kCandidatosParcheador[candidato], objeto, destino, variante);
+  }
+  nativo::Fh2AnotarParcheVs(objeto, destino);
+}
+
+}  // namespace
+
+// CreatePixelShader / CreateVertexShader (r3 = 2008 container, the object comes back in r3).
+extern "C" __attribute__((weak)) REX_FUNC(__imp__sub_82AAAC08);
+REX_HOOK_RAW(sub_82AAAC08) {
+  const uint32_t contenedor = ctx.r3.u32;
+  const auto* entrada =
+      DireccionPlausible(contenedor) ? nativo::ganchos_detalle::IdentificarCreacion(base, contenedor, false) : nullptr;
+  __imp__sub_82AAAC08(ctx, base);
+  g_creados_ps.fetch_add(1, std::memory_order_relaxed);
+  nativo::ganchos_detalle::RecordarCreacion(ctx.r3.u32, entrada, false);
+}
+
+extern "C" __attribute__((weak)) REX_FUNC(__imp__sub_82AAADF0);
+REX_HOOK_RAW(sub_82AAADF0) {
+  const uint32_t contenedor = ctx.r3.u32;
+  const auto* entrada =
+      DireccionPlausible(contenedor) ? nativo::ganchos_detalle::IdentificarCreacion(base, contenedor, true) : nullptr;
+  __imp__sub_82AAADF0(ctx, base);
+  g_creados_vs.fetch_add(1, std::memory_order_relaxed);
+  nativo::ganchos_detalle::RecordarCreacion(ctx.r3.u32, entrada, true);
+}
+
+// The vertex fetch patcher (FH2: r3 = VS object, r4 = destination, r7 = variant).
+#define FH1_PARCHEADOR(indice, direccion)                                                    \
+  extern "C" __attribute__((weak)) REX_FUNC(__imp__sub_##direccion);                         \
+  REX_HOOK_RAW(sub_##direccion) {                                                            \
+    const uint32_t objeto = ctx.r3.u32, destino = ctx.r4.u32, variante = ctx.r7.u32;         \
+    __imp__sub_##direccion(ctx, base);                                                       \
+    Parcheador(indice, objeto, destino, variante);                                           \
+  }
+FH1_PARCHEADOR(0, 8243AE38)
+FH1_PARCHEADOR(1, 8243AE3C)
+FH1_PARCHEADOR(2, 8243AE40)
+FH1_PARCHEADOR(3, 8243AE44)
+FH1_PARCHEADOR(4, 8243AE48)
+FH1_PARCHEADOR(5, 8243AE4C)
+FH1_PARCHEADOR(6, 8243AE50)
+#undef FH1_PARCHEADOR
+
+std::string Fh1ResumenGanchos() {
+  std::string texto = fmt::format("creados PS {} VS {} (constructores {}{}); parcheador:",
+                                  g_creados_ps.load(std::memory_order_relaxed),
+                                  g_creados_vs.load(std::memory_order_relaxed),
+                                  __imp__sub_82AAAC08 ? "sub_82AAAC08 " : "falta sub_82AAAC08 ",
+                                  __imp__sub_82AAADF0 ? "sub_82AAADF0" : "falta sub_82AAADF0");
+  bool alguno = false;
+  for (size_t i = 0; i < kNumCandidatos; ++i) {
+    const uint64_t llamadas = g_llamadas[i].load(std::memory_order_relaxed);
+    if (llamadas) {
+      texto += fmt::format(" sub_{:08X} {} llamadas, {} con un VS conocido;", kCandidatosParcheador[i], llamadas,
+                           g_parches[i].load(std::memory_order_relaxed));
+      alguno = true;
+    }
+  }
+  if (!alguno) {
+    texto += " ningun candidato llamado";
+  }
+  return texto;
+}
+
+#else  // the disc's executable: the native renderer runs without these hooks
+
+std::string Fh1ResumenGanchos() { return "ninguno (build sin Title Update 4)"; }
+
+#endif
