From: =?UTF-8?q?Kenan=20Kasumovi=C4=87?=
 <46025606+Ken5998@users.noreply.github.com>
Date: Sun, 15 Nov 2026 17:06:32 +0000
Subject: [PATCH 5/5] feat(vulkan): enable the features the native renderer's
 shaders use

With vulkan_native_shader_features on (the native renderer sets it before
the device exists), the device also enables descriptor indexing (core in
1.2, the extension on 1.1 drivers), buffer device address, shaderInt64,
dynamic indexing of sampled image arrays and pipeline statistics queries,
where the device has them, and reports them in its properties. Off, the
device is created as before.
---
 include/rex/ui/vulkan/device.h  | 12 +++++++++
 src/ui/vulkan/vulkan_device.cpp | 44 +++++++++++++++++++++++++++++++++
 2 files changed, 56 insertions(+)

diff --git a/include/rex/ui/vulkan/device.h b/include/rex/ui/vulkan/device.h
index cc18d59..9247171 100644
--- a/include/rex/ui/vulkan/device.h
+++ b/include/rex/ui/vulkan/device.h
@@ -110,6 +110,8 @@ class VulkanDevice {
     bool shaderCullDistance = false;
     bool sparseBinding = false;
     bool sparseResidencyBuffer = false;
+    // The native renderer's pipeline statistics (vulkan_native_shader_features).
+    bool pipelineStatisticsQuery = false;
 
     // VK_KHR_sampler_mirror_clamp_to_edge (#15, promoted to 1.2)
 
@@ -123,6 +125,16 @@ class VulkanDevice {
 
     bool scalarBlockLayout = false;
 
+    // Features the native renderer's shaders need (vulkan_native_shader_features): requested
+    // before the device is created, enabled only where the device has them.
+    bool shaderInt64 = false;
+    bool shaderSampledImageArrayDynamicIndexing = false;
+    bool bufferDeviceAddress = false;
+    bool runtimeDescriptorArray = false;
+    bool descriptorBindingPartiallyBound = false;
+    bool descriptorBindingSampledImageUpdateAfterBind = false;
+    bool descriptorBindingUpdateUnusedWhilePending = false;
+
     // VK_KHR_portability_subset (#164)
 
     bool constantAlphaColorBlendFactors = false;
diff --git a/src/ui/vulkan/vulkan_device.cpp b/src/ui/vulkan/vulkan_device.cpp
index ba79939..d6c6988 100644
--- a/src/ui/vulkan/vulkan_device.cpp
+++ b/src/ui/vulkan/vulkan_device.cpp
@@ -38,6 +38,12 @@ Fh1BreadcrumbExtension Fh1GetBreadcrumbExtension() {
 }
 }  // namespace rex::ui::vulkan
 
+// The native renderer (FH2 Recompiled's, built into the game; it sets this before the device exists):
+// the features its translated shaders use, enabled where the device has them.
+REXCVAR_DEFINE_BOOL(vulkan_native_shader_features, false, "UI/Vulkan",
+                    "Enable the features the native renderer's shaders use")
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+
 REXCVAR_DEFINE_BOOL(vulkan_require_fragment_stores_and_atomics, true, "UI/Vulkan",
                     "Deprecated and ignored for parity; fragmentStoresAndAtomics is always "
                     "required for Vulkan GPU emulation")
@@ -222,6 +228,11 @@ std::unique_ptr<VulkanDevice> VulkanDevice::CreateIfSupported(
     // #238.
     XE_UI_VULKAN_STRUCT_EXTENSION(EXT_memory_budget)
   }
+  bool ext_1_2_EXT_descriptor_indexing = false;
+  if (get_physical_device_properties2_supported && REXCVAR_GET(vulkan_native_shader_features)) {
+    // #162. The native renderer's texture heaps on Vulkan 1.1 drivers (core in 1.2).
+    XE_UI_VULKAN_LOCAL_PROMOTED_EXTENSION(EXT_descriptor_indexing, 1, 2)
+  }
   if (properties.apiVersion >= VK_MAKE_API_VERSION(0, 1, 1, 0)) {
     // #414.
     XE_UI_VULKAN_STRUCT_PROMOTED_EXTENSION(KHR_maintenance4, 1, 3)
@@ -414,10 +425,15 @@ std::unique_ptr<VulkanDevice> VulkanDevice::CreateIfSupported(
   VulkanFeatures<VkPhysicalDevicePresentModeFifoLatestReadyFeaturesKHR,
                  VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PRESENT_MODE_FIFO_LATEST_READY_FEATURES_KHR>
       features_KHR_present_mode_fifo_latest_ready;
+  VulkanFeatures<VkPhysicalDeviceDescriptorIndexingFeatures,
+                 VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DESCRIPTOR_INDEXING_FEATURES>
+      features_1_2_EXT_descriptor_indexing;
 
   if (get_physical_device_properties2_supported) {
     if (properties.apiVersion >= VK_MAKE_API_VERSION(0, 1, 2, 0)) {
       features_1_2.Link(supported_features_2, device_create_info);
+    } else if (ext_1_2_EXT_descriptor_indexing) {
+      features_1_2_EXT_descriptor_indexing.Link(supported_features_2, device_create_info);
     }
     if (properties.apiVersion >= VK_MAKE_API_VERSION(0, 1, 3, 0)) {
       features_1_3.Link(supported_features_2, device_create_info);
@@ -741,10 +757,38 @@ std::unique_ptr<VulkanDevice> VulkanDevice::CreateIfSupported(
       }
       if (metalfx_requested) features_1_2.enabled.timelineSemaphore = features_1_2.supported.timelineSemaphore;
     }
+    if (REXCVAR_GET(vulkan_native_shader_features)) {
+      XE_UI_VULKAN_FEATURE_2(features_1_2, bufferDeviceAddress);
+      // Unbounded texture and sampler tables, filled while command buffers record.
+      XE_UI_VULKAN_FEATURE_2(features_1_2, runtimeDescriptorArray);
+      XE_UI_VULKAN_FEATURE_2(features_1_2, descriptorBindingPartiallyBound);
+      XE_UI_VULKAN_FEATURE_2(features_1_2, descriptorBindingSampledImageUpdateAfterBind);
+      XE_UI_VULKAN_FEATURE_2(features_1_2, descriptorBindingUpdateUnusedWhilePending);
+    }
   } else {
     if (ext_1_2_KHR_sampler_mirror_clamp_to_edge) {
       XE_UI_VULKAN_FEATURE_IMPLIED(samplerMirrorClampToEdge)
     }
+    if (ext_1_2_EXT_descriptor_indexing && REXCVAR_GET(vulkan_native_shader_features)) {
+      XE_UI_VULKAN_FEATURE_2(features_1_2_EXT_descriptor_indexing, runtimeDescriptorArray);
+      XE_UI_VULKAN_FEATURE_2(features_1_2_EXT_descriptor_indexing, descriptorBindingPartiallyBound);
+      XE_UI_VULKAN_FEATURE_2(features_1_2_EXT_descriptor_indexing,
+                             descriptorBindingSampledImageUpdateAfterBind);
+      XE_UI_VULKAN_FEATURE_2(features_1_2_EXT_descriptor_indexing,
+                             descriptorBindingUpdateUnusedWhilePending);
+    }
+  }
+  if (REXCVAR_GET(vulkan_native_shader_features)) {
+    // Any API version. shaderInt64 is optional for the native shaders; enabled when present.
+    XE_UI_VULKAN_FEATURE(shaderInt64)
+    XE_UI_VULKAN_FEATURE(shaderSampledImageArrayDynamicIndexing)
+    // Pipeline statistics: without the feature the query pool cannot be created.
+    XE_UI_VULKAN_FEATURE(pipelineStatisticsQuery)
+    if (!with_gpu_emulation) {
+      XE_UI_VULKAN_FEATURE(independentBlend)
+      XE_UI_VULKAN_FEATURE(samplerAnisotropy)
+      XE_UI_VULKAN_FEATURE(fullDrawIndexUint32)
+    }
   }
 
   if (properties.apiVersion >= VK_MAKE_API_VERSION(0, 1, 3, 0)) {
-- 
